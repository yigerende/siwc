# =============================================================================
# sub2api-siwc 多阶段构建（前端 embed + 后端 + 运行时）
# 构建上下文 = 仓库根目录；版本经 ARG VERSION 注入（与 manifest 兼容范围对应）。
# =============================================================================
FROM node:22-alpine AS frontend
ARG NPM_CONFIG_REGISTRY
ENV NODE_OPTIONS=--max-old-space-size=2048
WORKDIR /src
RUN npm install -g pnpm@9 --no-audit --no-fund
# 先装依赖（利用分层缓存），lockfileVersion 9.0 → pnpm 9
COPY frontend/package.json frontend/pnpm-lock.yaml ./frontend/
RUN cd frontend && \
    if [ -n "${NPM_CONFIG_REGISTRY}" ]; then pnpm config set registry "${NPM_CONFIG_REGISTRY}"; fi && \
    pnpm install --frozen-lockfile
COPY frontend/ ./frontend/
# 前端 legal 页面以 ?raw 引用仓库根 docs/legal 下的文档，必须一并拷入
COPY docs/legal/ ./docs/legal/
# vite outDir = ../backend/internal/web/dist（相对 frontend/），需先建好父目录
RUN mkdir -p /src/backend/internal/web
RUN cd frontend && pnpm run build

FROM golang:1.27.2-alpine AS backend
ENV GOMAXPROCS=2
WORKDIR /app
RUN apk add --no-cache git
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
# 前端产物放进 embed 目录（//go:embed all:dist）
COPY --from=frontend /src/backend/internal/web/dist ./internal/web/dist
ARG VERSION=0.2.17
RUN CGO_ENABLED=0 go build -p 2 -tags=embed -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/sub2api ./cmd/server

# 运行时（对齐 Dockerfile.goreleaser：pg_dump/psql 备份依赖 + 非 root 用户）
FROM postgres:18-alpine AS pg-client

FROM alpine:3.21
LABEL org.opencontainers.image.title="sub2api-siwc"
RUN apk add --no-cache \
    ca-certificates tzdata curl su-exec libpq zstd-libs lz4-libs \
    krb5-libs libldap libedit \
    && rm -rf /var/cache/apk/*
COPY --from=pg-client /usr/local/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=pg-client /usr/local/bin/psql /usr/local/bin/psql
COPY --from=pg-client /usr/local/lib/libpq.so.5* /usr/local/lib/

RUN addgroup -g 1000 sub2api && \
    adduser -u 1000 -G sub2api -s /bin/sh -D sub2api
WORKDIR /app

COPY --from=backend /out/sub2api /app/sub2api
COPY --chown=sub2api:sub2api backend/resources /app/resources
RUN mkdir -p /app/data && chown -R sub2api:sub2api /app
COPY deploy/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:${SERVER_PORT:-8080}/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/app/sub2api"]
