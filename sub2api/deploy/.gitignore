# Data directories (generated at runtime when using docker-compose.local.yml)
data/
postgres_data/
redis_data/

# Environment configuration (contains sensitive information)
.env

# Backup files
*.backup
*.bak

# Temporary files
*.tmp
*.log

# SIWC Docker runtime data
sub2api-siwc-data*/
sub2api-siwc-postgres-data*/
sub2api-siwc-redis-data*/
